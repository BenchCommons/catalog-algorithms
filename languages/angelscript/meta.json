{
  "name": "AngelScript",
  "files": [
    "HelloWorld.as"
  ],
  "section": "game",
  "test": {
    "group": "docker",
    "image": "gcc:14.3.0",
    "run": "curl -fsSL -o /tmp/as.zip https://www.angelcode.com/angelscript/sdk/files/angelscript_2.37.0.zip && unzip -q /tmp/as.zip -d /tmp && make -s -j4 -C /tmp/sdk/angelscript/projects/gnuc >/dev/null 2>&1 && make -s -C /tmp/sdk/samples/asrun/projects/gnuc >/dev/null 2>&1 && /tmp/sdk/samples/asrun/bin/asrun HelloWorld.as"
  }
}
