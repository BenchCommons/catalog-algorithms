  "name": "Vue (SFC)",
  "files": [
    "HelloWorld.vue"
  ],
  "section": "markup",
  "test": {
    "group": "docker",
    "image": "node:22.12.0-slim",
    "run": "npm i -s --no-save vue@3.5.13 >/dev/null 2>&1 && node -e 'const fs=require(\"fs\"),sfc=require(\"@vue/compiler-sfc\");const t=sfc.parse(fs.readFileSync(\"HelloWorld.vue\",\"utf8\")).descriptor.template;fs.writeFileSync(\"r.mjs\",sfc.compileTemplate({source:t.content,filename:\"HelloWorld.vue\",id:\"hello\"}).code);import(\"./r.mjs\").then(m=>require(\"vue/server-renderer\").renderToString(require(\"vue\").createSSRApp({render:m.render}))).then(console.log)'"
  }
}
